TELEGRAM_BOT_TOKEN=*** API key, get one at https://app.aporto.tech/settings
# to route all AI calls through Aporto. New accounts receive up to $3
# in free credit. Leave it unset (or remove this line) to use Google
# Gemini as the default AI provider. When both APORTO_API_KEY and
# GOOGLE_API_KEY are set, Aporto is used.
APORTO_API_KEY=your_a...n

# AI provider (alternative to Aporto): Google Gemini. Required if
# APORTO_API_KEY is not set. When both are set, Aporto wins.
# GOOGLE_API_KEY=*** list of Telegram user IDs
ALLOWED_USERS=123456789,987654321

# Optional: webhook mode
WEBHOOK_URL=https://your-domain.com
PORT=8080

# Optional: persistent FSM storage
REDIS_URL=redis://localhost:6379/0
