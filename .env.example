TELEGRAM_BOT_TOKEN=your_t...n

# AI provider: at least one of GOOGLE_API_KEY or APORTO_API_KEY is required.
#
# Google Gemini (default):
GOOGLE_API_KEY=your_k...m
#
# Aporto (optional alternative): one API key for many models, with
# discounted routed pricing where available. Set APORTO_API_KEY in your
# .env to route all AI calls through https://aporto.tech. Get a key at
# https://app.aporto.tech/settings.
# When both are set, Aporto is used.
# APORTO_API_KEY=your_aporto_api_key

# Optional: restrict bot to a list of Telegram user IDs
ALLOWED_USERS=123456789,987654321

# Optional: webhook mode
WEBHOOK_URL=https://your-domain.com
PORT=8080

# Optional: persistent FSM storage
REDIS_URL=redis://localhost:6379/0
