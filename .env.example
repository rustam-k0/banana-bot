# Required Telegram token
TELEGRAM_BOT_TOKEN=123456789:replace_me

# Configure keys for every provider used in a chain. Google is the default fallback.
OPENAI_API_KEY=replace_me
XAI_API_KEY=replace_me
GOOGLE_API_KEY=replace_me

# Existing access-control variable; empty means public access.
ALLOWED_USERS=123456789,987654321
# Defaults to ALLOWED_USERS when omitted.
ADMIN_USERS=123456789

# Optional webhook and persistent Telegram FSM state.
# WEBHOOK_URL=https://bot.example.com
PORT=8080
# REDIS_URL=redis://localhost:6379/0

# Model chains: provider:model,provider:model
CHAT_FAST_CHAIN=openai:gpt-5.6-luna,google:gemini-3.5-flash
CHAT_BALANCED_CHAIN=openai:gpt-5.6-terra,google:gemini-3.5-flash
CHAT_COMPLEX_CHAIN=openai:gpt-5.6-sol,google:gemini-3.5-pro
IMAGE_PRO_CHAIN=openai:gpt-image-2,google:gemini-3.1-flash-image
IMAGE_FAST_CHAIN=xai:grok-imagine-image-quality,google:gemini-3.1-flash-image
TRANSCRIPTION_CHAIN=openai:gpt-4o-mini-transcribe,google:gemini-3.5-flash
FILE_ANALYSIS_CHAIN=openai:gpt-5.6-terra,google:gemini-3.5-flash
SPEECH_CHAIN=openai:tts-1
SPEECH_VOICE=alloy

# Reliability and bounded-response controls.
REQUEST_TIMEOUT_SECONDS=180
CONNECT_TIMEOUT_SECONDS=10
HTTP_RETRIES=2
RATE_LIMIT_PER_MINUTE=20
MAX_OUTPUT_TOKENS=700
DETAILED_OUTPUT_TOKENS=1800
# Intentionally fixed by startup validation.
MEMORY_MESSAGES=8
LOG_LEVEL=INFO
