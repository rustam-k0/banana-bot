[Unit]
Description=Banana Telegram Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/banana-bot
EnvironmentFile=/opt/banana-bot/.env
ExecStart=/opt/banana-bot/.venv/bin/python /opt/banana-bot/bot.py
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
